# E-Learning Management System - Environment Configuration
# Copy this file to .env and update with your actual values

# Application Settings
APP_NAME=E-Learning Resource Repository
APP_VERSION=2.0.0
APP_DEBUG=false

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=elearning_db
DB_USER=root
DB_PASSWORD=
DB_TIMEZONE=UTC

# API Configuration
API_TIMEOUT=30
RATE_LIMIT=100

# Security
ENABLE_CORS=true
CORS_ORIGINS=*
ENABLE_CSRF=true
SESSION_TIMEOUT=3600

# File Upload
MAX_UPLOAD_SIZE=52428800
ALLOWED_FILE_TYPES=jpg,png,gif,pdf

# Logging
ENABLE_LOGS=true
LOG_LEVEL=INFO

# Email Configuration (for notifications)
EMAIL_FROM=noreply@elearning.local
EMAIL_FROM_NAME=E-Learning Repository
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Pagination
DEFAULT_LIMIT=20
MAX_LIMIT=100
